{
  "manifest_version": 3,
  "name": "BeeSkip — YouTube Auto Skip",
  "version": "1.0.0",
  "description": "Automatically skips YouTube ads with a cute bee animation",
  "permissions": ["storage", "debugger"],
  "host_permissions": ["*://*.youtube.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BeeSkip — YouTube Auto Skip",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/bee.svg"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}